        color: const Color(0xFF0D131F),
        padding: const EdgeInsets.all(6),
        child: Row(
          children: [
            _actionBtn('AUTO'),
            _actionBtn('5 m'),
            _actionBtn('10 m'),
            _actionBtn('20 m'),
            _actionBtn('40 m'),
            _actionBtn('Paleta'),
            _actionBtn('Wyczysć'),
            const Spacer(),
            ElevatedButton(
              style: ElevatedButton.styleFrom(backgroundColor: Colors.red, shape: const CircleBorder(), padding: const EdgeInsets.all(16)),
              onPressed: () {},
