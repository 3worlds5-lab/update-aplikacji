      );
    } else if (_currentTab == 1) {
      return Container(
        color: const Color(0xFF0D131F),
        padding: const EdgeInsets.all(6),
        child: SingleChildScrollView(
          scrollDirection: Axis.horizontal,
          child: Row(
            children: [
              _actionBtn('+ Punkt tu'),
              _actionBtn('Ustaw HOME'),
              _actionBtn('Start trasy'),
              _actionBtn('Powrót'),
              _actionBtn('Mapowanie'),
              _actionBtn('Punkty'),
              _actionBtn('Eksport CSV'),
              _actionBtn('Wyczyść ślad'),
