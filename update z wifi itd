import 'dart:async';
import 'dart:math';
import 'package:flutter/material.dart';

void main() {
  runApp(const TF650App());
}

class TF650App extends StatelessWidget {
  const TF650App({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'TF650 Control',
      debugShowCheckedModeBanner: false,
      theme: ThemeData.dark().copyWith(
        scaffoldBackgroundColor: const Color(0xFF090D16),
        cardColor: const Color(0xFF101726),
        colorScheme: const ColorScheme.dark(
          primary: Color(0xFF00E676),
          secondary: Color(0xFF00B0FF),
          surface: Color(0xFF101726),
        ),
      ),
      home: const MainControlScreen(),
    );
  }
}

class MainControlScreen extends StatefulWidget {
  const MainControlScreen({super.key});

  @override
  State<MainControlScreen> createState() => _MainControlScreenState();
}

class _MainControlScreenState extends State<MainControlScreen> {
  int _currentTab = 0; // 0: SONAR, 1: MAPA, 2: STEROWANIE
  bool _isConnected = false;
  bool _isAutoMode = false;
  
  // Telemetria
  double _depth = 0.0;
  double _temp = 18.4;
  int _heading = 0;
  double _speed = 0.0;
  int _satellites = 0;
  double _distToHome = 0.0;
  double _battery = 12.6;

  // Ustawienia systemowe (SETTINGS)
  String _wifiSsid = "TF650_BOAT_NET";
  String _wifiPass = "12345678";
  String _ipAddress = "192.168.4.1";
  int _port = 8080;
  double _lightPower = 80;
  bool _obrysowki = true;
  bool _downloadOfflineMaps = true;
  double _gpsUpdateRate = 5; // Hz

  // Zmienne do wykresu Sonaru
  List<double> _sonarData = [];
  Timer? _telemetryTimer;

  @override
  void initState() {
    super.initState();
    _startSimulatedData();
  }

  void _startSimulatedData() {
    _telemetryTimer = Timer.periodic(const Duration(milliseconds: 500), (timer) {
      if (_isConnected) {
        setState(() {
          _depth = 1.8 + Random().nextDouble() * 0.4;
          _heading = (_heading + 1) % 360;
          _speed = _isAutoMode ? 1.4 : 0.0;
          _satellites = 14;
          _distToHome = 42.5;
          _sonarData.add(_depth);
          if (_sonarData.length > 80) _sonarData.removeAt(0);
        });
      }
    });
  }

  @override
  void dispose() {
    _telemetryTimer?.cancel();
    super.dispose();
  }

  void _toggleConnection() {
    setState(() {
      _isConnected = !_isConnected;
      if (!_isConnected) {
        _depth = 0.0;
        _speed = 0.0;
        _satellites = 0;
        _distToHome = 0.0;
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: SafeArea(
        child: Column(
          children: [
            _buildTopHeader(),
            _buildTelemetryBar(),
            Expanded(child: _buildMainContent()),
            _buildBottomActionBar(),
            _buildTabNavigationBar(),
          ],
        ),
      ),
    );
  }

  // --- TOP HEADER ---
  Widget _buildTopHeader() {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
      color: const Color(0xFF0D131F),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        children: [
          Row(
            children: const [
              Icon(Icons.directions_boat, color: Color(0xFF00E676), size: 20),
              SizedBox(width: 8),
              Text(
                'TF650 Control',
                style: TextStyle(fontWeight: FontWeight.bold, fontSize: 16, color: Colors.white),
              ),
            ],
          ),
          Row(
            children: [
              Container(
                padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                decoration: BoxDecoration(
                  color: _isConnected ? Colors.green.withOpacity(0.2) : Colors.red.withOpacity(0.2),
                  borderRadius: BorderRadius.circular(4),
                  border: Border.all(color: _isConnected ? Colors.green : Colors.red),
                ),
                child: Row(
                  children: [
                    Icon(Icons.circle, size: 8, color: _isConnected ? Colors.green : Colors.red),
                    const SizedBox(width: 6),
                    Text(_isConnected ? 'ON' : 'OFF', style: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold)),
                  ],
                ),
              ),
              const SizedBox(width: 8),
              ElevatedButton(
                style: ElevatedButton.styleFrom(
                  backgroundColor: _isConnected ? Colors.red[800] : const Color(0xFF1E293B),
                  padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                ),
                onPressed: _toggleConnection,
                child: Text(_isConnected ? 'Rozłącz' : 'Połącz', style: const TextStyle(color: Colors.white, fontSize: 12)),
              ),
              const SizedBox(width: 8),
              IconButton(
                icon: const Icon(Icons.settings, color: Colors.grey),
                onPressed: _showSettingsDialog,
                tooltip: 'Ustawienia (Settings)',
              ),
            ],
          ),
        ],
      ),
    );
  }

  // --- PASEK TELEMETRII ---
  Widget _buildTelemetryBar() {
    return Container(
      padding: const EdgeInsets.symmetric(vertical: 8, horizontal: 12),
      color: const Color(0xFF0B101B),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceAround,
        children: [
          _buildTelemetryItem('GŁĘBOKOŚĆ', '${_depth.toStringAsFixed(1)} m', Colors.cyanAccent),
          _buildTelemetryItem('TEMP', _isConnected ? '$_temp °C' : '--', Colors.white70),
          _buildTelemetryItem('KURS', '$_heading°', Colors.white70),
          _buildTelemetryItem('PRĘDKOŚĆ', '${_speed.toStringAsFixed(1)} m/s', Colors.white70),
          _buildTelemetryItem('SAT', '$_satellites', Colors.amberAccent),
          _buildTelemetryItem('DO HOME', _isConnected ? '${_distToHome.toStringAsFixed(1)} m' : '--', Colors.white70),
          _buildTelemetryItem('AKU', _isConnected ? '${_battery.toStringAsFixed(1)} V' : '--', Colors.greenAccent),
        ],
      ),
    );
  }

  Widget _buildTelemetryItem(String label, String value, Color valueColor) {
    return Column(
      mainAxisSize: MainAxisSize.min,
      children: [
        Text(label, style: const TextStyle(fontSize: 9, color: Colors.grey, fontWeight: FontWeight.w600)),
        const SizedBox(height: 2),
        Text(value, style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold, color: valueColor)),
      ],
    );
  }

  // --- ZAWARTOŚĆ GŁÓWNA ---
  Widget _buildMainContent() {
    switch (_currentTab) {
      case 0:
        return _buildSonarView();
      case 1:
        return _buildMapView();
      case 2:
        return _buildControlView();
      default:
        return _buildSonarView();
    }
  }

  // EKRAN SONAR
  Widget _buildSonarView() {
    return Container(
      width: double.infinity,
      color: Colors.black,
      child: !_isConnected
          ? const Center(child: Text('Brak danych — naciśnij „Połącz”', style: TextStyle(color: Colors.grey)))
          : CustomPaint(
              painter: SonarPainter(_sonarData),
              child: Container(),
            ),
    );
  }

  // EKRAN MAPA
  Widget _buildMapView() {
    return Container(
      color: const Color(0xFF070A10),
      child: Stack(
        children: [
          Center(
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                const Icon(Icons.map_outlined, size: 64, color: Colors.white24),
                const SizedBox(height: 12),
                Text(
                  _downloadOfflineMaps ? "Siatka Mapy GPS (Tryb Offline Włączony)" : "Mapa Wi-Fi Online",
                  style: const TextStyle(color: Colors.white54),
                ),
              ],
            ),
          ),
          Positioned(
            left: 10,
            bottom: 10,
            child: Container(
              padding: const EdgeInsets.all(4),
              color: Colors.black54,
              child: const Text('Scale: 50 m', style: TextStyle(color: Colors.white, fontSize: 10)),
            ),
          ),
        ],
      ),
    );
  }

  // EKRAN STEROWANIE
  Widget _buildControlView() {
    return Row(
      children: [
        Expanded(
          child: Center(
            child: Container(
              width: 120, height: 120,
              decoration: BoxDecoration(shape: BoxShape.circle, color: Colors.white10, border: Border.all(color: Colors.cyan)),
              child: const Center(child: Text('GAZ / SKRĘT', style: TextStyle(fontSize: 10, color: Colors.grey))),
            ),
          ),
        ),
        Expanded(
          child: Center(
            child: Container(
              width: 120, height: 120,
              decoration: BoxDecoration(shape: BoxShape.circle, color: Colors.white10, border: Border.all(color: Colors.green)),
              child: const Center(child: Text('KAMERA / KLAPY', style: TextStyle(fontSize: 10, color: Colors.grey))),
            ),
